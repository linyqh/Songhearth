{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Songhearth",
  "version": "0.1.0",
  "identifier": "com.songhearth.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Songhearth",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 22, "y": 26 },
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Music/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "shortDescription": "本地 AI 音乐生成",
    "longDescription": "基于 audio.cpp 的本地音乐生成客户端，支持 YuE2、ACE-Step、MiniMax Music 3 与 Stable Audio 3。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "resources/engine/": "engine/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
